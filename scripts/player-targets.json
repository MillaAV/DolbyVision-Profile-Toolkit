{
  "targets": [
    {
      "name": "Microsoft Media Player",
      "package": "Microsoft.ZuneMusic",
      "executables": [
        "Microsoft.Media.Player.exe"
      ],
      "enabled": true
    },
    {
      "name": "Movies & TV",
      "package": "Microsoft.ZuneVideo",
      "executables": [
        "Video.UI.exe"
      ],
      "enabled": true
    },
    {
      "name": "Photos",
      "package": "Microsoft.Windows.Photos",
      "executables": [
        "Microsoft.Photos.exe",
        "Photos.exe"
      ],
      "enabled": true
    }
  ],
  "notes": "Unified AutoHook installs and attaches to Microsoft Media Player, Movies & TV and Photos. HEVC preflight timeout is 2000 ms for Media Player and Movies & TV; Photos retains its established native handling."
}
